{
  "name": "task-flow",
  "version": "0.1.0",
  "private": true,
  "description": "桌面端个人任务执行应用",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron.mjs electron-vite dev",
    "start": "node scripts/run-electron.mjs electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "selfcheck": "electron-vite build && node scripts/run-electron.mjs electron out/main/index.js --selfcheck",
    "selfcheck:dist": "node scripts/run-electron.mjs sh -c \"release/mac*/TaskFlow.app/Contents/MacOS/TaskFlow --selfcheck\"",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --config electron-builder.yml --dir",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "db:generate": "drizzle-kit generate",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
